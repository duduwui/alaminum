# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# FIREBASE CONFIGURATION (For client handoff & cloud database)
# Obtain these from Firebase Console -> Project Settings -> General -> Web App Config
VITE_FIREBASE_API_KEY="your-api-key"
VITE_FIREBASE_AUTH_DOMAIN="winhome-project.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="winhome-project"
VITE_FIREBASE_STORAGE_BUCKET="winhome-project.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID="123456789012"
VITE_FIREBASE_APP_ID="1:123456789012:web:abcdef123456"

# ADMIN DASHBOARD ACCESS PASSCODE
VITE_ADMIN_PASSCODE="admin123"
