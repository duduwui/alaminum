# Winhome European Fenestration - Firebase Configuration
# Copy this file to .env or .env.local and replace with your Firebase Project credentials:

VITE_FIREBASE_API_KEY=AIzaSyYourApiKeyHere
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef12345678
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Winhome PostgreSQL Database Configuration (Self-Hosted VPS or Local)
# Format: postgresql://[user]:[password]@[host]:[port]/[database]
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/winhome_db
SUPER_ADMIN_PASSWORD=replace-with-a-unique-12-plus-character-secret

# Optional password-reset email delivery (Resend)
PUBLIC_APP_URL=https://your-doorhome-domain.example
RESEND_API_KEY=
GOOGLE_TRANSLATION_API_KEY=
TRANSLATION_CACHE_FILE=translation_cache_db.json
RESET_EMAIL_FROM=Doorhome <accounts@your-doorhome-domain.example>
# Or discrete parameters:
# PGHOST=localhost
# PGPORT=5432
# PGUSER=postgres
# PGPASSWORD=your_postgres_password
# PGDATABASE=winhome_db
